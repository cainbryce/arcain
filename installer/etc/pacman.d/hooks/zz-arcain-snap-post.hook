# Snapshot after pacman is done, and prune. The 'zz' prefix puts this after the
# hooks that rebuild things — mkinitcpio in particular — so the post snapshot
# contains the initramfs that matches the packages that were just installed.

[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = Snapshotting after this transaction...
When = PostTransaction
Depends = btrfs-progs
NeedsTargets
Exec = /usr/local/bin/arcain-snap hook post
