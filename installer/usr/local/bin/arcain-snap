#!/usr/bin/env bash
# arcain-snap — btrfs snapshots without a daemon.
#
#   arcain-snap create [-t TAG] [-d DESC] [config...]   take a read-only snapshot
#   arcain-snap list   [config...]                      what exists
#   arcain-snap prune  [config...]                      apply the retention policy
#   arcain-snap backup [config...]                      incremental send to the backup disk
#   arcain-snap hook   pre|post                         called by the pacman hooks
#   arcain-snap rollback SNAPSHOT                       print the recovery procedure
#
# With no config named, every config in /etc/arcain/snap.conf is used.
#
# This exists instead of snapper because the EFI stub boot design deletes the
# boot menu, and boot menu integration was the only thing snapper provided here
# that btrfs-progs does not. See docs/LAYOUT.md for the comparison. No daemon,
# no D-Bus, no XML, and deliberately no qgroups: retention is by count and age,
# never by space accounting.

set -euo pipefail

# ARCAIN_SNAP_CONF exists so the retention logic can be exercised against a
# throwaway tree without touching the real one.
config_file="${ARCAIN_SNAP_CONF:-/etc/arcain/snap.conf}"
readonly config_file
readonly version='1.0.0'

# Defaults. /etc/arcain/snap.conf overrides them.
declare -A CONFIGS=( [root]='/' )
SNAPSHOT_DIR='/.snapshots'
BACKUP_TARGET='/mnt/backup'
KEEP_PREPOST=20
KEEP_HOURLY=24
KEEP_DAILY=7
KEEP_WEEKLY=4

msg()  { printf '\033[1;34m::\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m::\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m::\033[0m %s\n' "$*" >&2; exit 1; }

if [[ -r "${config_file}" ]]; then
    # shellcheck source=/dev/null
    source "${config_file}"
fi

stamp() { date -u +%Y-%m-%dT%H-%M-%SZ; }

require_root() { (( EUID == 0 )) || die 'must run as root'; }

# The config names to operate on: the ones named, or all of them.
selected_configs() {
    local name
    if (( $# )); then
        for name in "$@"; do
            [[ -v CONFIGS[${name}] ]] || die "no such config: ${name}"
            printf '%s\n' "${name}"
        done
    else
        printf '%s\n' "${!CONFIGS[@]}" | sort
    fi
}

# Snapshot directory names for a config, oldest first. The names are ISO 8601
# in UTC, so a lexical sort is a chronological one. '|| true' because find
# fails on a config that has never been snapshotted, and under pipefail that
# would abort a caller using command substitution.
snapshots_of() {
    find "${SNAPSHOT_DIR}/$1" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null \
        | sort || true
}

# --- create -----------------------------------------------------------------
do_create() {
    require_root
    local tag='manual' desc='' name src dest
    local OPTIND=1

    while getopts 't:d:' opt; do
        case "${opt}" in
            t) tag="${OPTARG}" ;;
            d) desc="${OPTARG}" ;;
            *) return 1 ;;
        esac
    done
    shift $(( OPTIND - 1 ))

    while read -r name; do
        src="${CONFIGS[${name}]}"
        if ! btrfs subvolume show "${src}" &>/dev/null; then
            warn "${name}: ${src} is not a btrfs subvolume, skipping"
            continue
        fi
        install -d -m 0755 -- "${SNAPSHOT_DIR}/${name}"
        dest="${SNAPSHOT_DIR}/${name}/$(stamp)-${tag}"

        # Two snapshots inside the same second would collide. Rare, but a
        # pacman transaction that finishes instantly makes it reachable.
        if [[ -e "${dest}" ]]; then
            dest="${dest}.$$"
        fi

        btrfs subvolume snapshot -r -- "${src}" "${dest}" >/dev/null
        {
            printf 'source=%s\n' "${src}"
            printf 'tag=%s\n' "${tag}"
            printf 'created=%s\n' "$(date -u --iso-8601=seconds)"
            if [[ -n "${desc}" ]]; then printf 'description=%s\n' "${desc}"; fi
        } > "${dest}.info"
        msg "${name}: ${dest##*/}"
    done < <(selected_configs "$@")
}

# --- list -------------------------------------------------------------------
do_list() {
    local name snap
    local -a all
    while read -r name; do
        mapfile -t all < <(snapshots_of "${name}")
        printf '\033[1m%s\033[0m  (%s)\n' "${name}" "${CONFIGS[${name}]}"
        if (( ${#all[@]} == 0 )); then
            printf '  (none)\n'
            continue
        fi
        for snap in "${all[@]}"; do
            printf '  %s\n' "${snap}"
        done
    done < <(selected_configs "$@")
}

# --- prune ------------------------------------------------------------------
# Walks newest to oldest marking keepers, rather than counting per time bucket.
# A machine that was powered off for a week then keeps its last daily instead
# of pruning itself down to nothing.
do_prune() {
    require_root
    local name snap tag day week i n_daily n_weekly
    local -a all prepost timeline
    local -A keep covered_day covered_week

    while read -r name; do
        all=() prepost=() timeline=()
        keep=() covered_day=() covered_week=()
        n_daily=0 n_weekly=0

        mapfile -t all < <(snapshots_of "${name}")
        (( ${#all[@]} )) || continue

        for (( i = ${#all[@]} - 1; i >= 0; i-- )); do
            snap="${all[i]}"
            tag="${snap##*-}"
            case "${tag}" in
                pre|post) prepost+=("${snap}") ;;
                timeline) timeline+=("${snap}") ;;
                *)        keep["${snap}"]=1 ;;   # manual snapshots are never pruned
            esac
        done

        for (( i = 0; i < ${#prepost[@]} && i < KEEP_PREPOST; i++ )); do
            keep["${prepost[i]}"]=1
        done

        # Newest KEEP_HOURLY outright, then the newest snapshot from each day
        # not already covered, then from each ISO week not already covered.
        #
        # Coverage and budget are tracked separately on purpose. If the hourly
        # and daily keepers did not mark their weeks as covered, the weekly
        # budget would be spent re-keeping weeks the dailies already hold, and
        # four "weeklies" would buy about two extra days of history instead of
        # four extra weeks.
        for (( i = 0; i < ${#timeline[@]}; i++ )); do
            snap="${timeline[i]}"
            day="${snap%%T*}"
            week="$(date -u -d "${day}" +%G-W%V 2>/dev/null || printf '%s' "${day}")"

            if (( i < KEEP_HOURLY )); then
                keep["${snap}"]=1
                covered_day["${day}"]=1
                covered_week["${week}"]=1
            elif [[ ! -v covered_day[${day}] ]] && (( n_daily < KEEP_DAILY )); then
                keep["${snap}"]=1
                covered_day["${day}"]=1
                covered_week["${week}"]=1
                n_daily=$(( n_daily + 1 ))
            elif [[ ! -v covered_week[${week}] ]] && (( n_weekly < KEEP_WEEKLY )); then
                keep["${snap}"]=1
                covered_week["${week}"]=1
                n_weekly=$(( n_weekly + 1 ))
            fi
        done

        for snap in "${all[@]}"; do
            if [[ -v keep[${snap}] ]]; then
                continue
            fi
            btrfs subvolume delete -- "${SNAPSHOT_DIR}/${name}/${snap}" >/dev/null
            rm -f -- "${SNAPSHOT_DIR}/${name}/${snap}.info"
            msg "${name}: pruned ${snap}"
        done
    done < <(selected_configs "$@")
}

# --- backup -----------------------------------------------------------------
# 'btrfs send -p' against the newest snapshot present on BOTH sides. Anything
# else is a full send, which is correct but expensive, so a missing parent is
# reported rather than quietly accepted.
do_backup() {
    require_root
    local name latest parent target snap
    local -a all send_args

    if ! findmnt -no TARGET -- "${BACKUP_TARGET}" &>/dev/null; then
        warn "backup target ${BACKUP_TARGET} is not mounted — nothing to do"
        return 0
    fi

    while read -r name; do
        mapfile -t all < <(snapshots_of "${name}")
        if (( ${#all[@]} == 0 )); then
            warn "${name}: no snapshots to send"
            continue
        fi
        latest="${all[-1]}"
        target="${BACKUP_TARGET}/${name}"
        install -d -m 0755 -- "${target}"

        if [[ -e "${target}/${latest}" ]]; then
            msg "${name}: ${latest} is already on the target"
            continue
        fi

        parent=''
        for (( i = ${#all[@]} - 1; i >= 0; i-- )); do
            snap="${all[i]}"
            if [[ -d "${target}/${snap}" ]]; then
                parent="${snap}"
                break
            fi
        done

        if [[ -n "${parent}" ]]; then
            msg "${name}: sending ${latest} incrementally against ${parent}"
            send_args=(-p "${SNAPSHOT_DIR}/${name}/${parent}")
        else
            warn "${name}: no common parent on the target, sending ${latest} in full"
            send_args=()
        fi

        # A killed receive leaves a partial subvolume behind that would later
        # be mistaken for a valid parent, so it goes on any failure.
        if ! btrfs send "${send_args[@]}" -- "${SNAPSHOT_DIR}/${name}/${latest}" \
                | btrfs receive -- "${target}"; then
            warn "${name}: send failed, removing the partial receive"
            btrfs subvolume delete -- "${target}/${latest}" &>/dev/null || true
            continue
        fi
        cp -- "${SNAPSHOT_DIR}/${name}/${latest}.info" "${target}/" 2>/dev/null || true
        msg "${name}: ${latest} landed on ${target}"
    done < <(selected_configs "$@")
}

# --- pacman hook ------------------------------------------------------------
do_hook() {
    local phase="${1:-}" targets=''
    [[ "${phase}" == 'pre' || "${phase}" == 'post' ]] || die 'hook takes pre or post'

    # The hooks declare NeedsTargets, so the package list arrives on stdin.
    if [[ ! -t 0 ]]; then
        targets="$(tr '\n' ' ' | cut -c1-200)"
    fi

    # A failed snapshot must not abort somebody's upgrade: it is a lost safety
    # net, not a broken transaction. Hence no AbortOnFail in the hook files.
    if ! do_create -t "${phase}" -d "pacman: ${targets:-unknown}"; then
        warn 'snapshot failed, continuing anyway'
    fi
    if [[ "${phase}" == 'post' ]]; then
        do_prune || warn 'prune failed'
    fi
}

# --- rollback ---------------------------------------------------------------
# Prints rather than acts, on purpose. Rolling back the running root means
# renaming the subvolume the shell is standing in, so it has to be driven from
# the arcain ISO against a filesystem that is not the booted one.
do_rollback() {
    local snap="${1:-}"
    [[ -n "${snap}" ]] || die 'rollback needs a snapshot path'

    cat <<INSTRUCTIONS
Rolling back ${snap}. Run this from the arcain ISO, not from the installed
system: the subvolume being replaced is the one a booted system stands in.

  1. Mount the top of the filesystem, not a subvolume:

       mkdir -p /mnt/top
       mount -o subvolid=5 /dev/nvme0n1p2 /mnt/top

  2. Move the current root aside rather than deleting it, so this is reversible:

       mv /mnt/top/@ /mnt/top/@.broken-\$(date -u +%Y%m%dT%H%M%SZ)

  3. A snapshot is read-only, so restore it as a new writable subvolume:

       btrfs subvolume snapshot ${snap} /mnt/top/@

  4. Rebuild the unified kernel images. This step is not optional. The UKI
     lives on the FAT ESP, outside btrfs, so it did not roll back with @ and
     still matches the newer kernel:

       mount /dev/nvme0n1p1 /mnt/top/@/efi
       arch-chroot /mnt/top/@ mkinitcpio -P

  5. Reboot. If it still will not come up, pick the fallback image from the
     firmware boot menu — it is built with -S autodetect and carries a superset
     of modules.

Once the system is healthy again, delete /mnt/top/@.broken-*.
INSTRUCTIONS
}

# --- dispatch ---------------------------------------------------------------
command="${1:-}"
shift || true

case "${command}" in
    create)   do_create "$@" ;;
    list)     do_list "$@" ;;
    prune)    do_prune "$@" ;;
    backup)   do_backup "$@" ;;
    hook)     do_hook "$@" ;;
    rollback) do_rollback "$@" ;;
    version)  printf 'arcain-snap %s\n' "${version}" ;;
    ''|help|-h|--help) sed -n '2,18p' "${BASH_SOURCE[0]}" ;;
    *)        die "unknown command: ${command}" ;;
esac
