#!/usr/bin/env bash
# arcain-install — the installer that replaces archinstall on this medium.
#
# Phase 3 of the project. Right now this is a skeleton: it establishes the
# structure and the safety rails, and stops before touching a disk.

set -euo pipefail

readonly version='0.0.1'

msg()  { printf '\033[1;34m::\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m::\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m::\033[0m %s\n' "$*" >&2; exit 1; }

(( EUID == 0 )) || die 'must run as root'
[[ -d /sys/firmware/efi ]] || die 'not booted in UEFI mode'

# ---------------------------------------------------------------------------
# TODO(cain): disk selection policy.
#
# This is the first decision the installer makes and the only one that can
# destroy data, so it is worth deciding deliberately rather than inheriting
# whatever archinstall does.
#
# Fill in select_target_disk(). It should print the chosen block device path
# (e.g. /dev/nvme0n1) on stdout and nothing else — callers capture it.
#
# Things to weigh:
#   - Auto-pick when exactly one candidate disk exists, or always prompt?
#     Auto-picking is convenient on a fresh machine and catastrophic on a
#     machine that already has a system on that one disk.
#   - Which devices even count as candidates? `lsblk -dno NAME,TYPE` lists
#     loop devices, zram, and the arcain USB stick itself. Excluding the boot
#     medium matters: `lsblk -no PKNAME "$(findmnt -no SOURCE /run/archiso/bootmnt)"`
#     names it.
#   - Does a disk with existing partitions need a second confirmation, typed
#     rather than y/n?
#   - Refuse outright, or allow, when the disk is mounted or holds an active
#     LVM/RAID member?
# ---------------------------------------------------------------------------
# shellcheck disable=SC2329  # not wired into main() until it is implemented
select_target_disk() {
    die 'select_target_disk() is not implemented yet'
}

main() {
    msg "arcain-install ${version}"
    warn 'installer not implemented — this medium is live/rescue only for now'
    exit 1
}

main "$@"
